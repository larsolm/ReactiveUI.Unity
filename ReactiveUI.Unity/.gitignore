# Unity project rules. Paths starting with / are relative to this folder.

# Generated by the editor.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE project files Unity regenerates from the asmdefs.
/*.csproj
/*.slnx

# Test runner scratch scenes.
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# Paid Asset Store packages used by the sandbox. Their licenses forbid redistribution, so each
# developer imports them from the Asset Store. ReactiveUI builds without either: SoapDefine drops
# REACTIVEUI_SOAP when Soap is absent, and nothing outside Soap uses Odin.
/[Aa]ssets/Plugins/Sirenix/
/[Aa]ssets/Plugins/Sirenix.meta
/[Aa]ssets/Plugins/Obvious/
/[Aa]ssets/Plugins/Obvious.meta
