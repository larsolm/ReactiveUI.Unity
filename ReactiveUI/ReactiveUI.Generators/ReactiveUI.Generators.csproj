<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The Roslyn generators Unity runs while compiling any assembly that references ReactiveUI.

		Unity's constraints, all of which are load-bearing:
		  * netstandard2.0, and Microsoft.CodeAnalysis 4.3 or older — Unity's compiler loads nothing newer.
		  * No other dependencies. Unity loads the generator DLL alone, so anything it references
		    would fail to resolve at compile time.
		  * The copy in the package is labelled RoslynAnalyzer with every platform disabled; see its .meta.
	-->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsPackable>false</IsPackable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>

		<UnityPackagePath>Runtime/Generators/</UnityPackagePath>
		<UnityTargetFramework>netstandard2.0</UnityTargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ReactiveUI.Generators.Tests" />
	</ItemGroup>

</Project>
